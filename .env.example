# GEMINI_API_KEY: Required only if adding server-side Gemini features.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# OPTIONAL: Firebase Client Configuration for External Channel Database & Admin Auth
# Leave empty to run NOVA TV in Local Demo Mode (uses local JSON + browser storage).
# Never put private server admin keys or service account credentials in VITE_* variables.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
